{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swipelate",
  "mainBinaryName": "swipelate",
  "version": "0.1.23",
  "identifier": "com.quicktranslate.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Swipelate",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "thydynh03",
    "copyright": "Copyright (c) 2026 thydynh03. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Bôi đen để dịch ở mọi ứng dụng",
    "longDescription": "Swipelate dịch văn bản bạn bôi đen ở bất kỳ ứng dụng nào và hiện bản dịch ngay tại chỗ. Dịch online, offline và OCR.",
    "homepage": "https://thydynh03.github.io/swipelate/",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
